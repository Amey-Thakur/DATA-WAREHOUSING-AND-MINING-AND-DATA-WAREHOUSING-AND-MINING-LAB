# Data Warehousing and Mining - Academic Repository
# Specialized .gitignore for data science and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# Java Build Artifacts
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# SQL / Database Artifacts
*.db
*.sqlite
*.sqlite3
*.mdb
*.ldb
*.frm
*.ibd
*.myi
*.myd

# Data Mining Datasets & Archives
# We keep small datasets (.csv, .arff) as they are often lab inputs.
# Ignore large binary archives if any.
*.gz
*.zip
*.tar
*.rar
*.7z

# Temporary and Cache files
*.tmp
*.log
.cache/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
