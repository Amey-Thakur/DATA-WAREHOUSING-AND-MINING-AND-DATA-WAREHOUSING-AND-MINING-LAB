# Data Warehousing and Mining - Academic Repository
# Professional .gitattributes for scholarly archiving

# Set default behavior to automatically normalize line endings
* text=auto

# Ensure text and source files use LF on checkout
*.md text eol=lf
*.txt text eol=lf
*.java text eol=lf diff=java
*.py text eol=lf diff=python
*.sql text eol=lf
*.R text eol=lf
*.csv text eol=lf
*.arff text eol=lf
*.cff text eol=lf
LICENSE text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary

# Improve diff handling
*.md text diff=markdown
*.csv text
*.arff text
